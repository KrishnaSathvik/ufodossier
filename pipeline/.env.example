# supabase (service role key — needed for pipeline writes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# anthropic (powers Haiku extraction in extract.py)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3

# extraction stays on Haiku for V2
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-haiku-4-5

# Ask the Archive. Production stays on Anthropic until the migration sequence flips it.
# RAG_PROVIDER=openai
# RAG_MODEL=gpt-6-sol
# RAG_REASONING_EFFORT=medium
# RAG_FALLBACK_MODEL=gpt-6-sol
# RAG_FALLBACK_REASONING_EFFORT=low
# RAG_SECONDARY_PROVIDER=anthropic
# ANTHROPIC_RAG_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=sk-...
